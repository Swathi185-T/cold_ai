{
  "experiment_id": "iot_temperature_readings",
  "dataset": "Temperature Readings: IoT Devices (02_iot_temperature_readings)",
  "data_type": "PUBLIC_DATASET",
  "model": "MAD-TCN",
  "features": [
    "temperature",
    "humidity",
    "ambient_temperature",
    "power_kw",
    "compressor_state",
    "door_open",
    "temperature_delta",
    "rolling_mean",
    "rolling_std",
    "temperature_slope",
    "ambient_difference",
    "power_delta"
  ],
  "sequence_length": 60,
  "forecast_horizon": 15,
  "batch_size": 64,
  "epochs": 12,
  "learning_rate": 0.001,
  "train_split": 0.7,
  "val_split": 0.15,
  "test_split": 0.15,
  "random_seed": 42
}